  "summary": "将语音指令、目标检测与SAM 2分割接入OpenVLA/Llama 2动作模型，完成器械抓取与递交。区分未用器械示范的视觉模块测试和器械示范微调后的结果。",
  "method": {
    "input": "深度相机图像与术者语音指令",
    "output": "离散动作token及机械臂控制",
    "flow": [
      "语音与目标分割",
      "视觉语言动作融合",
      "专域动作适配"
    ],
    "explanation": "将语音指令、目标检测与SAM 2分割接入OpenVLA/Llama 2动作模型，完成器械抓取与递交。区分未用器械示范的视觉模块测试和器械示范微调后的结果。",
    "modules": [
      {
        "name": "语音与目标分割",
        "purpose": "定位指令指向的器械及人手",
        "mechanism": "Gladia语音转文本，定制YOLOv8给出目标/手框，SAM 2输出视觉特征与掩码。",
        "input": "深度相机图像与术者语音指令",
        "output": "语音与目标分割的中间结果"
      },
      {
        "name": "视觉语言动作融合",
        "purpose": "连接分割表征和动作生成",
        "mechanism": "两层MLP把视觉特征投影到OpenVLA的Llama 2 7B，连续动作每维离散为256个bin。",
        "input": "语音与目标分割的结果",
        "output": "视觉语言动作融合的中间结果"
      },
      {
        "name": "专域动作适配",
        "purpose": "学习器械姿态与交接方式",
        "mechanism": "冻结视觉模块，对Llama 2使用LoRA和动作token交叉熵微调；推理反token化后执行。",
        "input": "视觉语言动作融合的结果",
        "output": "离散动作token及机械臂控制"
      }
    ],
