    "explanation": "用物理仿真把人与机器人的接触式照护任务统一为可训练环境，建模人体能力与偏好，并提供四类机器人、六类日常辅助任务的强化学习基线。",
    "modules": [
      {
        "name": "人体与接触仿真",
        "purpose": "使辅助过程可重复训练",
        "mechanism": "建模人体关节限制、体型变化、接触及人对受力和动作的偏好。",
        "input": "仿真人体状态、机器人观测与照护任务",
        "output": "人体与接触仿真的中间结果"
      },
      {
        "name": "任务与机器人统一接口",
        "purpose": "比较不同平台能力",
        "mechanism": "覆盖抓痒、擦浴、喂食、喝水、穿衣和手臂重定位及PR2/Jaco/Baxter/Sawyer。",
        "input": "人体与接触仿真的结果",
        "output": "任务与机器人统一接口的中间结果"
      },
      {
        "name": "PPO与人机共同优化",
        "purpose": "研究主动协作人体的作用",
        "mechanism": "比较静态人体和人/机器人各自学习策略的共同优化；这是仿真结果。",
        "input": "任务与机器人统一接口的结果",
        "output": "机器人控制及接触/偏好奖励"
      }
