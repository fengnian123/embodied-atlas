  "summary": "用多模型协同交叉验证处理施工安全视觉检查，作为具身巡检中的可靠视觉判别相关工作。",
  "method": {
    "input": "施工安全图像与检查问题",
    "output": "安全判断及解释",
    "flow": [
      "多个视觉推理分支",
      "交叉检查候选判断",
      "汇总一致性结论"
    ],
    "assumptions": "专业类别与图像分布影响结论",
    "difference": "通过交叉验证改善视觉判断。",
    "explanation": "Tandem CCV-VLM在静态工地图像上串联两个VLM。主模型生成描述或检测，次模型借助预置检索库把描述映射到统一领域词汇；CCV过滤器再用交叉一致性约束修正主输出。作者比较硬过滤、软过滤等模式，覆盖描述、安全规则和对象定位。它没有负责机器人移动或主动采集，是可用作巡检视觉后端的离线图像系统。",
    "modules": [
      {
        "name": "主VLM感知",
        "purpose": "输出原始多任务预测",
        "mechanism": "GPT-4o或LLaVA-13b根据图像和任务生成描述、违规或对象框",
        "input": "工地图像和规则",
        "output": "候选描述/检测"
      },
      {
        "name": "检索与次VLM重映射",
        "purpose": "统一领域词汇和表达",
        "mechanism": "利用预置语义检索模块生成re-mapped captions",
        "input": "候选描述、领域词库",
        "output": "标准化参考描述"
      },
      {
        "name": "CCV过滤",
        "purpose": "降低不一致预测",
        "mechanism": "比较主次模型输出，以硬/软交叉核验模式保留或修正候选",
        "input": "候选及标准化描述",
        "output": "经核验输出"
      }
    ]
  },
  "training": {
    "regime": "仅推理使用；原文未描述任务专属参数微调",
    "models": "GPT-4o API、LLaVA-13B本地推理；主/副模型串联",
    "trainable": "本文所述CCV过滤和检索不涉及参数训练；未报告微调目标",
    "frozen": "现成VLM推理；不能据此断言其原始预训练冻结范围",
    "data": "1000张施工安全图像用于评测，副模型使用检索增强材料",
    "objective": "无本文下游训练损失；以重映射caption对检测/grounding作硬、软或平衡过滤",
    "stages": "主模型生成描述/检测→副模型检索重映射描述→CCV过滤"
  },
