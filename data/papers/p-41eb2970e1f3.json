  "summary": "提供兼容dVRK的10任务手术机器人RL平台；以物理接触抓取代替近距离自动吸附，并用真实dVRK验证仿真训练策略迁移。",
  "method": {
    "input": "机器人模型、手术物体资产",
    "output": "真实机器人成功率",
    "flow": [
      "dVRK兼容物理仿真",
      "任务和奖励接口",
      "HER与示范辅助学习",
      "零样本实机迁移检验"
    ],
    "explanation": "SurRoL提供兼容dVRK接口的PyBullet手术训练环境，而不是一个只用于展示的固定任务脚本。平台重建PSM器械臂和ECM相机臂运动学，支持末端笛卡尔位移、夹爪与部分旋转动作；观测既可用仿真真值状态，也可渲染RGB/深度/掩码。原论文基线主要使用低维状态以先研究控制难点。多数任务使用目标稀疏奖励，移动目标相机跟踪采用稠密奖励；作者以DDPG/HER及少量脚本示范改善探索。关键设计是保留摩擦和真实接触式抓取，避免物体靠近夹爪便自动吸附。最后将四类技能迁移到真实dVRK，并用NeedlePick对照检验接触仿真的价值。",
    "modules": [
      {
        "name": "dVRK兼容物理仿真",
        "purpose": "减少环境接口与运动学迁移负担",
        "mechanism": "PyBullet重建PSM/ECM，接口与实机对齐；使用摩擦接触式抓取和位置控制。",
        "input": "机器人模型、手术物体资产",
        "output": "带接触动力学的Gym式环境"
      },
      {
        "name": "任务和奖励接口",
        "purpose": "显式定义控制学习问题",
        "mechanism": "10个PSM/ECM任务；通常给定目标，未成功奖励−1；ActiveTrack按持续跟踪效果给稠密奖励。",
        "input": "状态、目标、动作",
        "output": "下一状态、奖励、成功标志"
      },
      {
        "name": "HER与示范辅助学习",
        "purpose": "缓解接触任务稀疏奖励与探索失败",
        "mechanism": "使用DDPG/HER；以脚本策略采集少量示范辅助复杂抓取、传递学习；本文主要用低维状态。",
        "input": "经验回放、目标、示范",
        "output": "低层连续动作策略"
      },
      {
        "name": "零样本实机迁移检验",
        "purpose": "验证物理建模的实际意义",
        "mechanism": "统一工作空间；将GauzeRetrieve、NeedlePick、PegTransfer和StaticTrack策略部署dVRK，单独比较自动吸附与接触仿真。",
        "input": "仿真策略与实机感知状态",
        "output": "真实机器人成功率"
      }
    ],
    "assumptions": null,
    "difference": null
  },
  "training": {
    "regime": "强化学习",
    "models": "DDPG、HER及HER+DEMO；非LLM/VLM策略。",
    "trainable": "连续动作策略与价值函数；示范帮助稀疏奖励探索。",
    "frozen": "无预训练VLM；不适用冻结主干描述。",
    "data": "PyBullet在线交互；部分复杂任务的脚本示范。",
    "objective": "最大化目标达成奖励或跟踪稠密回报，HER重标记目标。",
    "stages": "构建任务→仿真RL/示范辅助→选择策略→对齐实机接口部署。"
  },
  "evaluation": [
    {
      "benchmark": "真实dVRK NeedlePick",
      "setting": "每种训练方式50次真实测试；比较近距离自动吸附Approx@2mm与摩擦接触Interact",
