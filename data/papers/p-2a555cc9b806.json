  "limitations": {
    "author": [
      "研究没有覆盖传感与驱动方式差异很大的所有机器人类型；统一动作只是粗对齐。",
      "论文的跨机器人策略实验使用9种机械臂，不等于发布集合的22种机器人均参加策略训练。"
    ],
