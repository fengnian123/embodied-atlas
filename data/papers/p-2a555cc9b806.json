  "summary": "将多个机构的真实机器人示范标准化为可共同训练的数据集合，并以RT-1-X与RT-2-X检验跨机器人数据是否带来正迁移。该数据是通用操作基础资源，并非医疗专用。",
  "method": {
    "input": "不同机构相机、语言和动作轨迹",
    "output": "按协议分开的成功率",
    "flow": [
      "跨机构数据规范化",
      "RT-1-X策略",
      "RT-2-X共同微调",
      "跨域与消融验证"
    ],
    "explanation": "Open X-Embodiment首先解决数据接口不一致的问题：不同机器人数据统一为RLDS格式，选一个相机视角，保留语言指令，并将动作粗略映射到末端位姿变化及夹爪状态。统一的是数据格式和7维动作语义，不代表各机器人坐标系、控制频率和绝对/相对动作完全一致。随后作者分别训练RT-1-X与RT-2-X：前者用图像历史和语言条件预测离散动作，后者把动作编码为文本token，利用视觉语言预训练再进行机器人数据共同微调。最后用真实机器人测试同分布性能、未见物体/背景/环境与跨机器人涌现技能，并用移除Bridge、缩小模型、取消历史和取消预训练进行消融。",
    "modules": [
      {
        "name": "跨机构数据规范化",
        "purpose": "让异构机器人经验可以共同采样",
        "mechanism": "统一RLDS接口，选择标准相机，动作映射为x/y/z/roll/pitch/yaw/夹爪7维，并按数据集归一化。",
        "input": "不同机构相机、语言和动作轨迹",
        "output": "可共同训练的机器人数据混合"
      },
      {
        "name": "RT-1-X策略",
        "purpose": "检验机器人数据规模的正迁移",
        "mechanism": "35M RT-1基于EfficientNet视觉特征、语言FiLM调制和Transformer预测离散动作；以同架构单域RT-1作控制比较。",
        "input": "图像历史与指令",
        "output": "离散动作token"
      },
      {
        "name": "RT-2-X共同微调",
        "purpose": "利用大容量VLM吸收跨机器人技能",
        "mechanism": "基于PaLI-X的VLA将控制量离散化为文本token；机器人混合数据与原始VLM数据约1:1共同微调。",
        "input": "Web视觉语言预训练模型、机器人示范",
        "output": "跨机器人VLA控制策略"
      },
      {
        "name": "跨域与消融验证",
        "purpose": "分辨容量、数据来源和预训练的贡献",
        "mechanism": "分别测试涌现技能与RT-2泛化协议；移除Bridge等消融保持对比条件明确。",
        "input": "训练策略与真实机器人测试任务",
        "output": "按协议分开的成功率"
      }
    ],
    "assumptions": null,
    "difference": null
  },
  "training": {
    "regime": "监督微调",
    "models": "RT-1 (35M)、RT-2-PaLI-X (5B / 55B)。",
    "trainable": "RT-1-X机器人策略；RT-2-X基于预训练VLM共同微调为VLA。",
    "frozen": "不是冻结VLM仅推理的系统；模型细节以原文IV为准。",
    "data": "数据集合22种机器人、21机构、527技能；本文训练混合来自9种机械臂。",
    "objective": "离散动作token的分类交叉熵；RT-2-X同时使用视觉语言与机器人数据。",
    "stages": "多源格式统一→预训练初始化→机器人训练或VLM共同微调→实机评估。"
  },
  "evaluation": [
    {
      "benchmark": "跨机器人涌现技能与泛化",
      "setting": "Table II；Google Robot；RT-2泛化指未见物体/背景/环境，与涌现技能为不同测试",
      "result": "RT-2-X 55B的涌现技能成功率75.8%，RT-2为27.3%；普通泛化61%与62%，不能说所有测试均约3倍。",
