  "bibtex": "@misc{futurenav,\n  title={FutureNav: Unified World-Action Modeling for Vision-and-Language Navigation},\n  author={Lingfeng Zhang and Zeying Gong and Xiaoshuai Hao and Haoxiang Fu and Qiang Zhang and Mingliang Zhou and Hangjun Ye and Xiaojun Liang and Junwei Liang and Wenbo Ding},\n  year={2026},\n  eprint={2606.30367},\n  archivePrefix={arXiv},\n  url={https://arxiv.org/abs/2606.30367}\n}",
  "summary": "联合学习动作、正向动力学、逆向动力学和未来空间状态，推理默认只解码动作；收录 FutureNav-4B-Base 权重。",
  "overview": "FutureNav 在 Qwen3-VL 的图像特征之外引入冻结 VGGT 的空间特征，经残差融合送入语言主干。训练同时要求模型选择动作、根据动作预测下一状态、从观测变化反推动作，以及不依赖动作预测未来状态。三个辅助目标在训练中约束共享表征，默认推理关闭辅助预测头，保留带空间编码的动作路径。论文比较 4B / 8B 与有无外部导航数据的设置；已发布的 FutureNav-4B-Base 作为同一论文的模型资源收录。",
  "method": {
    "input": "语言指令、当前及历史 RGB",
    "output": "STOP、MOVE_FORWARD、TURN_LEFT、TURN_RIGHT 等低层动作文本",
    "explanation": "把空间状态、动作和状态转移作为联合监督：视觉与空间编码继续用于默认策略推理，辅助动力学和未来预测头可以关闭。",
    "assumptions": "VGGT 与 VLM 的图像预处理、token 数对齐和历史缓存；默认评测不是在线生成视频或多分支想象规划。",
    "difference": "世界模型主要作为训练监督塑造共享表示；未来预测目标是空间潜变量，而非直接合成未来 RGB。",
    "flow": [
      "视觉与空间融合",
      "动作策略",
      "正逆动力学",
      "未来状态与联合优化"
    ],
    "modules": [
      {
        "name": "视觉与空间融合",
        "purpose": "向策略注入几何感知信息",
        "input": "同一段 RGB 历史的 VLM 和 VGGT 特征",
        "mechanism": "冻结 VGGT 产生 2048 维空间 patch 特征，用邻域合并、RMSNorm 和两层 MLP 映射到 LLM 隐空间；token 数不匹配时插值，以 0.2 的残差权重加到视觉 embedding。",
        "output": "对齐后的语义—空间 token",
        "sourceUrl": "https://arxiv.org/html/2606.30367v1",
        "locator": "3.1–3.2"
      },
      {
        "name": "动作策略",
        "purpose": "产生可执行导航决策",
        "input": "融合后的 token、指令与动作提示",
        "mechanism": "语言模型自回归生成动作。仅 assistant 动作 token 参与交叉熵，system 和 user 文本标签被屏蔽，避免把输入复述当作动作监督。",
        "output": "离散动作及共享隐藏状态",
        "sourceUrl": "https://arxiv.org/html/2606.30367v1",
        "locator": "3.3 Action Policy"
      },
      {
        "name": "正逆动力学",
        "purpose": "约束动作与观测变化的一致性",
        "input": "当前状态、动作隐藏状态和相邻帧特征",
        "mechanism": "正向头把当前观测与 teacher-forced 动作状态映射到下一帧池化空间特征，使用 MSE；逆向头读取上下文、相邻帧均值与差分，分类导致变化的四类动作。",
        "output": "下一状态预测与逆向动作类别",
        "sourceUrl": "https://arxiv.org/html/2606.30367v1",
        "locator": "3.3 Forward / Inverse Dynamics"
      },
      {
        "name": "未来状态与联合优化",
        "purpose": "学习不依赖给定动作的短期状态先验",
        "input": "动作响应前的上下文与当前图像隐藏状态",
        "mechanism": "未来头不读取动作 token，预测下一帧的 2048 维空间状态；用动作 CE 加三项辅助损失联合训练，各辅助权重 0.1。默认评测关闭这些辅助头，直接从策略分支解码。",
        "output": "经过状态转移监督的导航策略",
        "sourceUrl": "https://arxiv.org/html/2606.30367v1",
        "locator": "3.3 Future Generation / 3.4"
      }
    ]
  },
  "training": {
    "regime": "冻结视觉 / 空间编码器，监督微调语言主干并联合训练辅助头",
    "models": "Qwen3-VL-4B / 8B；VGGT 提供空间特征与未来状态监督。",
    "trainable": "VLM 语言组件、多模态 merger 和 world-action heads。",
    "frozen": "VLM 视觉塔与 VGGT 空间编码器。",
    "data": "0K 设置仅用 R2R-CE 与 RxR-CE 专家轨迹，约 2.43M 样本（631K / 1.80M，按原文近似数）；完整设置增加 ScaleVLN 与 DAgger。Table 1 的外部数据是样本数，4B 为 10.457M，8B 为 10.435M。",
    "objective": "动作 token 交叉熵 + 0.1×正向状态 MSE + 0.1×逆向动作 CE + 0.1×未来状态 MSE。",
    "stages": "联合训练四目标；默认推理仅运行策略输出头，仍需视觉与空间编码。公开仓库已给出评测脚本，训练脚本与训练数据在 README 中仍列为待发布。"
  }
}
