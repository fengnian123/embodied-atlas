  "summary": "将异常解释与定位能力分支训练后融合，用比较推理和可验证奖励增强工业异常问答；属于视觉诊断支撑工作。",
  "method": {
    "input": "工业图像与参考图像/问题",
    "output": "异常判断、解释与定位",
    "flow": [
      "比较式推理监督",
      "GRPO 优化答案与框一致性",
      "训练分割适配分支",
      "融合任务向量"
    ],
    "assumptions": "主要基于图像异常数据",
    "difference": "把语义推理与定位适配分开优化。",
    "explanation": "InspectorGPT以正常参考图和查询图的显式比较为诊断依据。先SFT学习结构化差异推理，再以可验证的答案、框重叠和格式奖励做GRPO。另训练带Seg-LoRA与分割解码器的像素分支；由于分割提高异常判别却削弱语义任务，作者没有简单联合训练，而是对推理与分割分支做任务向量融合，平衡两类能力。",
    "modules": [
      {
        "name": "正常—查询双图比较",
        "purpose": "避免单图外观捷径",
        "mechanism": "围绕参考中正常结构解释查询图的异常位置、类型与影响",
        "input": "正常参考和查询图",
        "output": "有依据的CoT诊断"
      },
      {
        "name": "推理后训练",
        "purpose": "对齐文本判断与定位",
        "mechanism": "CoT-SFT后做GRPO，联合答案正确性、IoU和格式奖励",
        "input": "MMAD推理及框监督",
        "output": "InspectorGPT-Reason"
      },
      {
        "name": "Seg-LoRA分支",
        "purpose": "获得像素级缺陷掩码",
        "mechanism": "分割解码器加LoRA，使像素损失可影响骨干表征",
        "input": "图像对与掩码",
        "output": "InspectorGPT-Seg"
      },
      {
        "name": "任务向量融合",
        "purpose": "平衡判别与语义性能",
        "mechanism": "相对共同初始模型计算分支权重差，以α=0.3融合",
        "input": "两个训练分支",
        "output": "融合模型"
      }
    ]
  },
  "training": {
    "regime": "监督微调＋强化学习",
    "models": "Qwen2.5-VL-7B",
    "trainable": "推理适配、分割 LoRA 与融合参数",
    "frozen": "具体冻结配置按原文/代码核对",
    "data": "工业异常问答及定位监督",
    "objective": "SFT、GRPO、定位监督",
    "stages": "分支训练 → 任务向量融合"
  },
